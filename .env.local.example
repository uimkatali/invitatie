# Sablon gol, urmarit de git. NU scrie valori reale aici: completeaza .env.local (vezi SETUP.md).

# Baza de date TiDB (baza "dates")
DATABASE_URL=

# Secret pentru sesiuni (npm run gen-secret), minim 32 de caractere
SESSION_SECRET=

# Cei doi utilizatori: username si hash-ul parolei (npm run hash-password)
USER_EL_NAME=
USER_EL_PASSWORD_HASH=
USER_EA_NAME=
USER_EA_PASSWORD_HASH=

# Emailuri de notificare prin Gmail SMTP (optional: fara GMAIL_USER si GMAIL_APP_PASSWORD nu se trimit emailuri)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Adresele care primesc notificari (fiecare e optionala)
EMAIL_EL=
EMAIL_EA=

# Token-ul store-ului Vercel Blob PRIVAT
BLOB_READ_WRITE_TOKEN=

# Optional: baza linkurilor din emailuri (ex. https://invitatie.vercel.app, fara / la final)
APP_URL=
